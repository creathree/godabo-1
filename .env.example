# godabo1 — 環境変数テンプレ（値は入れない・リポジトリ可）
# 使い方: コピーして `.env.local` を作る（.env.local は git に含めない）
# 本番: `.env.production.example` 参照 → Secret Manager / Cloud Run（Imaju R-02 と同型）

# =============================================================================
# A. 公開 URL・サイト（ビルド時・NEXT_PUBLIC_* はブラウザに載る）
# =============================================================================
# NEXT_PUBLIC_SITE_URL=https://godabo-1.creathree.com
# NEXT_PUBLIC_CREATHREE_URL=https://creathree.com
# NEXT_PUBLIC_IMAJU_URL=https://imaju.creathree.com
# NEXT_PUBLIC_CREATHREE_X_URL=https://x.com/creathree

# =============================================================================
# B. Room / WSS（home 接続確認 → 将来 Room）
# =============================================================================
# Worker ベース URL（パス /room/{id} はクライアントが付与）
# NEXT_PUBLIC_GODABO_WSS_URL=wss://godabo-room.<account>.workers.dev

# =============================================================================
# C. Firebase Client（Web SDK）
# =============================================================================
# godabo-1 プロジェクトの Firebase コンソール値
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=godabo-1.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=godabo-1
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=godabo-1.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# D. Firebase Admin（サーバー・Route / API のみ）
# =============================================================================
# FIREBASE_PROJECT_ID=godabo-1
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# ローカル ADK 用のみ（任意）: GOOGLE_APPLICATION_CREDENTIALS=path/to.json

# =============================================================================
# E. 実行時秘密（サーバーのみ。Imaju の CREATHREE_MASTER_ID 相当は godabo 独自）
# =============================================================================
# Worker / API への Bearer、内部 cron など（本番は SM → Cloud Run）
# GODABO_MASTER_ID=          # Worker HMAC 鍵（未設定時）・将来 Bearer
# GODABO_ROOM_EPOCH=1        # Next が resolveRoomDoName するとき Worker と合わせる
# GEMINI_API_KEY=

# =============================================================================
# F. Upstash（middleware レート制限・IP ban。未設定でも middleware は落とさない）
# =============================================================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# G. ローカル開発 — Cloudflare Tunnel（package.json のパスは各自）
# =============================================================================
# CLOUDFLARED_CONFIG=C:/Users/you/.cloudflared/godabo-1.yml
# CLOUDFLARED_TUNNEL_NAME=godabo-1-dev

# =============================================================================
# H. bracket-i18n
# =============================================================================
# GEMINI_API_KEY=  （E と同じ変数。fill 時のみ）